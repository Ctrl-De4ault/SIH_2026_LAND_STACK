# ---------------------------------------------------------------------------
# Land Stack API — environment
# Copy this file to ".env" (cp .env.example .env) and adjust as needed.
# ---------------------------------------------------------------------------

# Leave MONGODB_URI EMPTY to auto-start an in-memory MongoDB on boot
# (zero database setup — perfect for a demo). The DB is re-seeded each start.
#
# For a PERSISTENT database, set a MongoDB connection string, e.g. Atlas:
#   MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net
# or a local server:
#   MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_URI=

DB_NAME=landstack
PORT=8080

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRY=12h

# CORS — the Vite dev server origin
CLIENT_ORIGIN=http://localhost:5173

# Set to "false" to skip auto-seeding when the database is empty
AUTO_SEED=true
